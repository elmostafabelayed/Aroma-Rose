# ==============================================================================
# Aroma Rose — Backend Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project.supabase.co or local http://127.0.0.1:54321)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (SAFE for client/browser exposure)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_key_placeholder

# ------------------------------------------------------------------------------
# CRITICAL SECURITY NOTICE:
# The SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
# MUST NEVER be exposed in the frontend or committed to git.
# It is used EXCLUSIVELY by the Node.js/Express backend server.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_key_placeholder

# Direct PostgreSQL Connection URL (used for local container tests & pooled DB access)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aroma_rose_test

# JWT Secret (for offline verification and test authentication)
JWT_SECRET=super-secret-jwt-token-key-for-aroma-rose-dev-only-min-32-chars
