{
  "name": "aroma-rose-api",
  "version": "1.0.0",
  "description": "Aroma Rose — Premium Moroccan Rose E-Commerce REST API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:api": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "docker exec -i aroma_rose_test_db psql -U postgres -d aroma_rose_test < supabase/seed.sql",
    "seed:catalog": "python3 scripts/process_catalog_and_seed.py",
    "test:db": "./tests/run_all_tests.sh",
    "test:api": "tsx tests/api/runner.ts",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:db && npm run test:api && npm run test:frontend"
  },
  "keywords": [
    "ecommerce",
    "morocco",
    "rose-water",
    "supabase",
    "express",
    "typescript"
  ],
  "author": "Aroma Rose Architect",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
